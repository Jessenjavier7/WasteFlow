// ========================================
// REPORT IMAGES
// ========================================

model ReportImage {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  report WasteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_images")
}

// ========================================
// REPORT STATUS HISTORIES
// ========================================

model ReportStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  reportId  String        @map("report_id") @db.Uuid
  changedBy String        @map("changed_by") @db.Uuid
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  note      String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  // Relations
  report WasteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  user User @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("report_status_histories")
}
