// ========================================
// WASTE CATEGORIES
// ========================================

model WasteCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  wasteReports WasteReport[] @relation("ConfirmedCategory")
  // aiPredictions AiPrediction[] @relation("PredictedCategory")

  @@map("waste_categories")
}

// ========================================
// WASTE REPORTS
// ========================================

model WasteReport {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  confirmedCategoryId String?      @map("confirmed_category_id") @db.Uuid
  description         String?      @db.Text
  title               String       @db.VarChar(100)
  latitude            Float?
  longitude           Float?
  address             String?      @db.Text
  status              ReportStatus @default(PENDING)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  confirmedCategory WasteCategory? @relation("ConfirmedCategory", fields: [confirmedCategoryId], references: [id], onDelete: SetNull)

  // aiPredictions   AiPrediction[]
  images          ReportImage[]
  statusHistories ReportStatusHistory[]

  @@index([userId])
  @@index([confirmedCategoryId])
  @@index([status])
  @@index([createdAt])
  @@map("waste_reports")
}

